extends SceneTree
const MECHANICS = preload("res://scripts/AetherMechanics.gd")

func _initialize() -> void:
	var recording: Dictionary = MECHANICS.start_recording()
	for i in range(100):
		MECHANICS.record_frame(recording, 0.1, Vector2(float(i), 250.0), i >= 30 and i < 70)
	assert(not recording["recording"])
	assert(recording["playing"])
	assert(recording["frames"].size() > 50)
	var echo: Dictionary = MECHANICS.clone_frame(recording, 4.0)
	assert(echo["switch"])
	assert(MECHANICS.can_open_echo_gate(echo, true))
	assert(not MECHANICS.can_open_echo_gate(echo, false))
	assert(MECHANICS.toggle_era("present") == "past")
	assert(MECHANICS.era_obstacle_passable("bridge", "past"))
	assert(not MECHANICS.era_obstacle_passable("bridge", "present"))
	assert(MECHANICS.era_obstacle_passable("collapsed_wall", "present"))
	var pulse: float = MECHANICS.sonar_pulse()
	assert(MECHANICS.sonar_visible(pulse))
	assert(not MECHANICS.sonar_visible(MECHANICS.update_sonar(pulse, 4.0)))
	var scale: Dictionary = MECHANICS.new_scale(5, [2, 3, 2, 3])
	assert(MECHANICS.scale_place(scale, 0, "left"))
	assert(MECHANICS.scale_place(scale, 1, "left"))
	assert(MECHANICS.scale_place(scale, 2, "right"))
	assert(MECHANICS.scale_place(scale, 3, "right"))
	assert(scale["solved"])
	assert(MECHANICS.scale_place(scale, 3, "remove"))
	assert(not scale["solved"])
	var melody: Dictionary = MECHANICS.new_melody([2, 0, 3, 1])
	assert(MECHANICS.play_note(melody, 2))
	assert(not MECHANICS.play_note(melody, 3))
	assert(melody["progress"] == 0)
	for note in [2, 0, 3, 1]:
		assert(MECHANICS.play_note(melody, note))
	assert(melody["solved"])
	var glyphs: Dictionary = {}
	assert(MECHANICS.learn_glyph(glyphs, "△", "MOON"))
	assert(MECHANICS.decipher(["△", "◇"], glyphs) == "MOON ?")
	print("AETHER MECHANICS TESTS PASSED")
	quit(0)
